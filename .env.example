# =============================================================================
# Spendsmith — environment variables
# Copy to `.env.local` for Next.js. Never commit real secrets.
# =============================================================================

# --- Mode / safety -----------------------------------------------------------
# true  = in-memory demo store (no live Supabase required)
# false = use Supabase (requires NEXT_PUBLIC_SUPABASE_* below)
DEMO_MODE=false

# mock | sandbox | production
# Production Execute calls require explicit production configuration.
ADS_EXECUTION_MODE=production

NODE_ENV=development
APP_URL=http://localhost:3000
# For Meta OAuth with Enforce HTTPS locked on, use:
# APP_URL=https://localhost:3000
# and run: npm run dev:https
# Valid OAuth Redirect URI: https://localhost:3000/api/auth/meta/callback
LOG_LEVEL=info

# Policy / ops knobs
ACCESS_REQUEST_STALE_DAYS=7
APPROVAL_EXPIRY_HOURS=72
BUDGET_CEILING_DEFAULT_CENTS=500000

# --- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local Supabase CLI defaults (when `supabase start`):
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<from `supabase status`>
# SUPABASE_SERVICE_ROLE_KEY=<from `supabase status`>

# Optional: only these email domains may self-register (comma-separated).
# Leave empty to allow any; self-registered users are operators with no client access.
SIGNUP_ALLOWED_DOMAINS=

# --- Token vault (AES) -------------------------------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never reuse the demo key from the repo. Rotate with scripts/rotate-token-key.mjs.
# 32-byte key, base64-encoded. Required when DEMO_MODE=false.
TOKEN_ENCRYPTION_KEY=

# --- Anthropic / agent -------------------------------------------------------
ANTHROPIC_API_KEY=
# Current Claude Sonnet (claude-sonnet-4-20250514 was retired June 2026)
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- OpenAI (chat titles + context research brief + GPT Image creatives) -----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# gpt-image-2 | gpt-image-1.5 | gpt-image-1 | gpt-image-1-mini
OPENAI_IMAGE_MODEL=gpt-image-2

# --- Firecrawl (website → services scrape for ad builder) --------------------
FIRECRAWL_API_KEY=

# --- SociaVault (Meta Ad Library competitor intel) ---------------------------
# https://docs.sociavault.com/api-reference/facebook-ad-library/company-ads
SOCIAVAULT_API_KEY=

# --- Workspace V2 (Facebook OAuth → Meta Graph API) --------------------------
WORKSPACE_V2_ENABLED=false
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0

# --- Trigger.dev -------------------------------------------------------------
TRIGGER_SECRET_KEY=
# Run chat turns as Trigger.dev background jobs (survive tab close, no
# request timeout). Needs the worker: `npm run trigger:dev` locally, or
# `npx trigger.dev deploy` with these env vars set in the Trigger dashboard.
AGENT_BACKGROUND_RUNS=false

# --- Gmail (access-request email) --------------------------------------------
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- Cloudflare R2 (creative assets; optional) -------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_BUCKET=
R2_ENDPOINT=

# --- Cloudinary (selected creative → public Meta-compatible URL) -------------
# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
